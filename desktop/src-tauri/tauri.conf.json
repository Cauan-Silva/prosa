{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prosa",
  "version": "0.1.0",
  "identifier": "com.cauansilva.prosa",
  "build": {
    "frontendDist": "../site"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "principal",
        "title": "Prosa",
        "url": "https://prosa-s4u4.onrender.com",
        "width": 1280,
        "height": 800,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Prosa: conversa, voz e vídeo com a sua turma",
    "copyright": "Cauan Silva",
    "category": "SocialNetworking",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"]
      }
    }
  }
}
